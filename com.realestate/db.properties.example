# ===================================================================
# 应用配置模板
#
# 用法：复制本文件为 db.properties，然后填写真实的值。
#      db.properties 已被 .gitignore 排除，不会进入版本库。
#
# 优先级（从高到低）：同名的系统属性  >  环境变量  >  本文件  >  代码内置默认值
# ===================================================================

# --------------------------------------------------------------- 数据库
# 也可用环境变量 DB_URL / DB_USER / DB_PASSWORD 覆盖
db.url=jdbc:mysql://localhost:3306/real_estate_db?useSSL=false&serverTimezone=UTC
db.user=root
db.password=your_password_here

# ------------------------------------------- 房东联系方式加密密钥（RISK-003）
# 必须配置，且不要提交到版本库——这个文件本身已 gitignore，所以填在这里是安全的。
#
# 生成一个 256 位密钥（AES-256）：
#     openssl rand -base64 32
# 把输出整行粘到下面 = 的后面即可。
#
# 也可改用环境变量 CONTACT_KEY 或启动参数 -Dcontact.key=<密钥> 覆盖本行。
#
# 注意：密钥直接决定库中密文能否解开。更换密钥前必须先做数据迁移
#      （用旧密钥解密、以新密钥重新加密），否则已有的联系方式会读不出来。
contact.key=replace_with_a_generated_base64_key
